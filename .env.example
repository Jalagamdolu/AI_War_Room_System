# AI War Room Decision System — Environment Variables
# Copy this file to .env and fill in the values before running.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual credentials
#
# NOTE: Never commit your .env file to version control.

# ---------------------------------------------------------------------------
# LLM API Keys (optional — only needed if you enable LLM-backed agents)
# ---------------------------------------------------------------------------

# Google Gemini (google-generativeai)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------------------------------------
# System Configuration
# ---------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Output directory for decision reports (relative to project root)
OUTPUT_DIR=output

# ---------------------------------------------------------------------------
# Data Paths (optional — override defaults)
# ---------------------------------------------------------------------------
METRICS_PATH=data/metrics.json
FEEDBACK_PATH=data/feedback.txt
RELEASE_NOTES_PATH=data/release_notes.txt
